<?xml version="1.0" encoding="utf-8"?>
<!-- 音乐首页海报变体（升级版58）：与经典 activity_music.xml 同 id 同类型，由 MusicActivity 在
     海报模式经 ActivityMusicBinding.bind 装载；经典布局一字不动。
     口径：整页洗色（代码按当前封面种子落色，通顶）；玻璃搜索胶囊（源管理收进胶囊右侧，
     搜索钮仅为绑定保留、不可见，搜索走键盘搜索键，与经典同语义）；站点胶囊行与四块玻璃入口
     （图标在上、文字在下）；搜索历史 / 最近播放 / 首页推荐横滑与经典同结构同行为。
     边距统一：内容容器左右 12dp、海报首页同值（AvMusicHomeSpec.CONTENT_MARGIN_DP），
     搜索栏 / 站点行 / 入口行 / 迷你条四者左右边距共用此值，迷你条经 include 边距落位。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <!-- 玻璃搜索胶囊：玻璃底由代码按主题落（AvGlassDrawable），源管理是胶囊内右侧小钮。 -->
        <LinearLayout
            android:id="@+id/avSearchCapsule"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="6dp">

            <ImageView
                android:id="@+id/avSearchIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_action_search" />

            <EditText
                android:id="@+id/searchInput"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@null"
                android:gravity="center_vertical"
                android:hint="@string/music_search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingVertical="0dp"
                android:singleLine="true"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/manageBtn"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="@string/music_manage"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 搜索钮：海报版式里不露面（搜索走键盘搜索键），仅为与经典共用同一绑定而保留。 -->
        <TextView
            android:id="@+id/searchBtn"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/siteChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- 四块玻璃入口：玻璃底与顶部线条图标由代码落，文字口径与经典一致。
             升级版59 第 1 条：块高随内容收拢——行高与块高均 wrap_content，块上下
             内边距 14dp（AvMusicHomeSpec.TILE_PADDING_V_DP），图标（26dp）与文字以
             代码落的 6dp 固定距相邻成组居中，不再被 88dp 固定块高拉开。 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/categoryBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:text="@string/music_category"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/recommendBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:text="@string/music_recommend"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/likesBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:text="@string/music_my_likes"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/playlistsBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:text="@string/music_my_playlists"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/historySection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/avHistoryTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/music_history"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/historyClear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="4dp"
                    android:text="@string/music_history_clear"
                    android:textSize="12sp" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/historyChips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="8dp" />
            </HorizontalScrollView>
        </LinearLayout>

        <!-- 升级版78 戊段：与经典布局同构同改——搜索结果页签行（歌曲｜歌手），
             钮式照席位页 modeSong/modeSinger、文案复用现串；默认 gone，只在搜索态出现。 -->
        <LinearLayout
            android:id="@+id/searchTabRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/modeSong"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/shape_item_round"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:text="@string/music_lx_mode_song"
                android:textColor="@color/selector_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/modeSinger"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/shape_item_round"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:text="@string/music_lx_mode_singer"
                android:textColor="@color/selector_text"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/listTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/music_recent"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/recentMore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/music_more"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 升级版78 丙段：与经典布局同改——resultsList 移出 ScrollView 改有界自滚
             （0dp＋weight=1），搜索态整表由它自己窗口化滚动；首页态由 MusicActivity 的
             applyResultsLayout 切回 wrap_content 摆最近播放，其下 homeScroll 承接推荐区。 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/resultsList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 升级版78 戊段：歌手页签结果列表（与 resultsList 同位同形态有界自滚，两签互斥显隐）。 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/singerResultsList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone" />

        <!-- 歌手签专属空态（歌曲签继续用 emptyText）。 -->
        <TextView
            android:id="@+id/singerEmptyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="16dp"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/emptyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="16dp"
            android:textSize="14sp"
            android:visibility="gone" />

        <ScrollView
            android:id="@+id/homeScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/recommendTitleRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingBottom="8dp"
                    android:paddingTop="12dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/recommendTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/music_recommend"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/recommendMore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:text="@string/music_more"
                        android:textSize="12sp" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recommendGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>

        <TextView
            android:id="@+id/noticeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="10dp"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <include
        android:id="@+id/miniPlayer"
        layout="@layout/layout_music_mini_player"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp" />
</LinearLayout>
