<?xml version="1.0" encoding="utf-8"?>
<!-- 音乐分类页：无返回键、无分类标题，顶上直接就是站点行（无全部，只靠点按切换）；
     分类内容是跟手翻页的分页器（左右滑或点类别胶囊切换，方式与点播一致）；当前分类自带筛选条件时类别行右侧出筛选入口；
     底部通栏迷你播放条，无底栏胶囊。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="10dp">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/siteChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal">

            <HorizontalScrollView
                android:id="@+id/typeScroll"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/typeChips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/filterBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/music_filter"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/typePager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/emptyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="16dp"
            android:textColor="#FFF0E8DA"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/noticeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="10dp"
            android:textColor="#FFF0E8DA"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <include
        android:id="@+id/miniPlayer"
        layout="@layout/layout_music_mini_player" />
</LinearLayout>
