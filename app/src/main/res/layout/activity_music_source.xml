<?xml version="1.0" encoding="utf-8"?>
<!-- 升级版75甲段：源管理页三卡改版（MusicFree／洛雪／本地音乐站点）。
     顶部标题＋总数；三卡由 RecyclerView 逐卡渲染（item_music_source_card）；
     内容边距与音乐首页同口径 12dp（盘点 C：旧页 16dp，改版一并对齐）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/music_manage"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/countText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 升级版77 戊段⑦：总开关行「接口音乐站点自动加载」（默认开；关时接口自动认领的
         音乐站不进音乐区，洛雪/MF/钉选不受影响）。经典与海报共用本页，一处加两处生效。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/interfaceAutoLoadLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/music_interface_auto_load"
            android:textSize="15sp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/interfaceAutoLoadSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/sourceList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1" />
</LinearLayout>
