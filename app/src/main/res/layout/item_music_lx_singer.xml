<?xml version="1.0" encoding="utf-8"?>
<!-- 念心席页歌手卡（升级版66 第 5 条）：与结果卡同网格口径——方形头像（圆角与 Vod.Grid 同步，
     圆形裁剪在适配器侧用 Glide 圆变换落，不新造形状资源）＋姓名条＋计数角标（歌曲数·专辑数）。 -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="@drawable/ripple_music_press"
    android:padding="2dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/singerAvatar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/black_20"
        android:scaleType="centerCrop"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/Vod.Grid" />

    <TextView
        android:id="@+id/singerMeta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/shape_vod_remark"
        android:singleLine="true"
        android:textColor="@color/text_remark"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@id/singerAvatar"
        app:layout_constraintStart_toStartOf="@id/singerAvatar" />

    <TextView
        android:id="@+id/singerName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/shape_vod_name"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/white"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="@id/singerAvatar"
        app:layout_constraintStart_toStartOf="@id/singerAvatar"
        app:layout_constraintTop_toBottomOf="@id/singerAvatar" />
</androidx.constraintlayout.widget.ConstraintLayout>
