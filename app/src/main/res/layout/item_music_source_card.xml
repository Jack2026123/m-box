<?xml version="1.0" encoding="utf-8"?>
<!-- 升级版75甲段：一张卡（圆角玻璃卡片；经典底见 shape_music_source_card，海报底由代码落无快照版 AvGlassDrawable）。
     卡内：卡头（分组名＋MF 的添加订阅）＋当前订阅小字（仅 MF）＋行容器＋卡底导入按钮。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/shape_music_source_card"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/cardTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/cardAddSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/shape_item_round"
            android:paddingVertical="6dp"
            android:text="@string/music_add_subscription"
            android:textColor="@color/selector_text"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/cardSub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingTop="4dp"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/cardRows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/footerBtn1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/shape_item_round"
            android:gravity="center"
            android:paddingVertical="10dp"
            android:textColor="@color/selector_text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/footerBtn2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/shape_item_round"
            android:gravity="center"
            android:paddingVertical="10dp"
            android:textColor="@color/selector_text"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
